<odoo>
  <record id="view_shipper_form_inherit_restriction" model="ir.ui.view">
    <field name="name">delivery.carrier.form.restriction</field>
    <field name="model">delivery.carrier</field>
    <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='description']" position="after">
        <page string="restrictions" name="custom_restrictions_tab">
          <group>
            <field name="restriction_tags_ids" widget="many2many_tags"/>
          </group>
        </page>
      </xpath>
    </field>

  </record>
</odoo>
