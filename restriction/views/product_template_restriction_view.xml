<odoo>
  <record id="view_delivery_product_template_restriction" model="ir.ui.view">
    <field name="name">product.template.delivery.restriction</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="stock.view_template_property_form"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='inventory']" position="inside">
        <group string="Restrictions d'expédition'">
          <field name="restriction_tags_ids" widget="many2many_tags" option="{'no_create': True}"/>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
